# ─── Dodo Payments (REQUIRED for billing) ────────────────────────────────────
# Get your API key from: Dodo Dashboard → Developer → API Keys
DODO_PAYMENTS_API_KEY=sk_test_xxxxxxxxxxxxxxxx

# Get your webhook key from: Dodo Dashboard → Developer → Webhooks → Your Endpoint → Overview tab
DODO_PAYMENTS_WEBHOOK_KEY=whsec_xxxxxxxxxxxxxxxx

# Use "test_mode" while testing, switch to "live_mode" when you go live
DODO_PAYMENTS_ENVIRONMENT=test_mode

# ─── Dodo Product IDs (OPTIONAL - auto-provisioned if not set) ────────────────
# Products will be automatically created in Dodo if these are not set.
# You can pre-create them using the setup script for more control:
#   DODO_PAYMENTS_API_KEY=sk_test_xxx DODO_PAYMENTS_ENVIRONMENT=test_mode npx tsx scripts/setup-dodo-products.ts
# Then paste the output product IDs here:

# A7.0 commercial catalog source. `code` is the default and the only source
# used by checkout/pricing in A7.0. `db` is reserved for A7.1.
CATALOG_SOURCE=code

# Commercial subscription plans — the live catalog (Explorer is free signup,
# Enterprise is a custom contract). Checkout creates any missing product at the
# catalog price, so these are optional; set them to lock the price.
#   scripts/provision-commercial-dodo-products.ts --apply
DODO_COMMERCIAL_PRODUCT_STARTER=
DODO_COMMERCIAL_PRODUCT_STARTER_ANNUAL=
DODO_COMMERCIAL_PRODUCT_GROWTH=
DODO_COMMERCIAL_PRODUCT_GROWTH_ANNUAL=
DODO_COMMERCIAL_PRODUCT_SCALE=
DODO_COMMERCIAL_PRODUCT_SCALE_ANNUAL=

# Legacy plan products — kept ONLY to attribute renewals of pre-existing Dodo
# subscriptions to their original plan. They are not sold any more.
DODO_PRODUCT_EXPLORER=
DODO_PRODUCT_STARTER=
DODO_PRODUCT_BUSINESS=
DODO_PRODUCT_PROFESSIONAL=
DODO_PRODUCT_ENTERPRISE=

# Permanent Credit Packs (auto-created if empty)
DODO_PRODUCT_PERM_50K=
DODO_PRODUCT_PERM_100K=
DODO_PRODUCT_PERM_300K=
DODO_PRODUCT_PERM_600K=
DODO_PRODUCT_PERM_1M=
DODO_PRODUCT_PERM_5M=

# ─── ATAI Ecosystem Internal API (REQUIRED for WEB ↔ MirrorSite integration) ─
# A shared secret used by the VettCode WEB app (atai.ink) to fetch project
# data server-to-server. Generate with: openssl rand -hex 32
# This key must match ATAI_INTERNAL_KEY in the WEB app's .env
ATAI_INTERNAL_KEY=your_shared_internal_key_here_min_32_chars

# ─── OpenRouter (REQUIRED for the AI build pipeline + Atai Runtime API) ─────
# Server-side only — never exposed to clients or generated applications.
# Used by two SEPARATE flows: Atai's internal build pipeline, and the customer
# runtime adapter (lib/runtime/router/adapters/openrouter).
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: default OpenRouter model for runtime chat requests that do not
# specify one (e.g. openai/gpt-5.2). Leave empty to require callers to send a model.
OPENROUTER_DEFAULT_MODEL=
# Optional: override ONLY for integration tests. Never set in production.
OPENROUTER_BASE_URL=
# Optional: provider request timeout in ms (default 60000, max 300000).
OPENROUTER_TIMEOUT_MS=

# ─── Onboarding (OPTIONAL) ───────────────────────────────────────────────────
# Fallback URL for the onboarding/getting-started video shown as a tour step
# in first-run onboarding and in the /docs tutorial embed.
# YouTube watch/share/Shorts links are normalized automatically; any other
# https embed URL is used as-is.
# An admin can override this at runtime from /admin → Site content →
# Onboarding video (stored in the site_settings collection).
NEXT_PUBLIC_ONBOARDING_VIDEO_URL=

# ─── ElevenLabs (OPTIONAL — voice synthesis for generated apps) ──────────────
# Get your API key from: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: default voice ID (callers may override per request).
ELEVENLABS_DEFAULT_VOICE_ID=
# Optional: default model (eleven_multilingual_v2, eleven_flash_v2_5, eleven_turbo_v2_5).
ELEVENLABS_DEFAULT_MODEL=
# Optional: request timeout in ms (default 60000).
ELEVENLABS_TIMEOUT_MS=

# ─── Firecrawl (OPTIONAL — web search/scrape for generated apps) ─────────────
# Get your API key from: https://firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
# Optional: request timeout in ms (default 30000).
FIRECRAWL_TIMEOUT_MS=

# ─── Resend (OPTIONAL — platform email: generated apps + newsletter) ─────────
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=
# Platform sender address (required for sending). The Runtime capability and
# the Atai Insights newsletter both send from this identity.
# Must be an address on a domain verified in Resend — currently hi@atai.ink.
RESEND_FROM_EMAIL=
# Optional: request timeout in ms (default 20000).
RESEND_TIMEOUT_MS=

# ─── Atai Insights (OPTIONAL — blog discovery + newsletter) ─────────────────
# IndexNow key file for the blog. The app serves it at
# https://atai.ink/indexnow/<key>.txt, which is the location submitted to the
# IndexNow API — nothing else has to be hosted.
INDEXNOW_KEY=
# Google Search Console API access for the blog sitemap. The private key is the
# service account key (newlines as \n). SITE_URL is a domain property, e.g.
# sc-domain:atai.ink
SEARCH_CONSOLE_CLIENT_EMAIL=
SEARCH_CONSOLE_PRIVATE_KEY=
SEARCH_CONSOLE_SITE_URL=
# Bing Webmaster API key (optional — IndexNow is the primary submission path).
BING_WEBMASTER_API_KEY=

# ─── Supabase (OPTIONAL — realtime notifications for generated apps) ─────────
# Project URL, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Server-side key used only by the Atai runtime; never ship it to app clients.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: request timeout in ms (default 20000).
SUPABASE_TIMEOUT_MS=

# ─── Mapbox (OPTIONAL — maps/geolocation for generated apps) ─────────────────
# Get your access token from: https://account.mapbox.com/access-tokens/
MAPBOX_ACCESS_TOKEN=
# Optional: request timeout in ms (default 30000).
MAPBOX_TIMEOUT_MS=

# ─── Cal.com (OPTIONAL — calendar/scheduling for generated apps) ──────────────
# Get your API key from: https://cal.com/settings/developer
CALCOM_API_KEY=
# Optional: request timeout in ms (default 30000).
CALCOM_TIMEOUT_MS=

# ─── Cloudflare (OPTIONAL — embeddings + vector database for generated apps) ──
# Get credentials from: https://dash.cloudflare.com → Workers & Pages → Vectorize
# ai.embed needs only TOKEN + ACCOUNT_ID. The `vectors` capability additionally
# needs VECTORIZE_INDEX (an index whose dimensions match the embedding model).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_VECTORIZE_INDEX=
# Optional: Workers AI embedding model (default @cf/baai/bge-base-en-v1.5 → 768 dims).
CLOUDFLARE_EMBEDDING_MODEL=
# Optional: request timeout in ms (default 30000).
CLOUDFLARE_TIMEOUT_MS=

# ─── Totalum (OPTIONAL — runtime database for generated apps) ────────────────
# Reuses the existing TOTALUM_API_KEY from the build system (no duplicate needed).
# If you want a separate runtime key, set TOTALUM_RUNTIME_BASE_URL.
TOTALUM_API_KEY=
# Optional: override the Totalum API base URL for runtime.
TOTALUM_RUNTIME_BASE_URL=
# Optional: request timeout in ms (default 30000).
TOTALUM_RUNTIME_TIMEOUT_MS=

# ─── Dodo Payments Runtime (OPTIONAL — payments for generated apps) ──────────
# Separate from the Atai platform billing Dodo credentials above.
# Get your API key from: https://dodopayments.com/dashboard → Developer → API Keys
DODO_PAYMENTS_API_KEY=
# Optional: request timeout in ms (default 30000).
DODO_PAYMENTS_TIMEOUT_MS=

# ─── Runtime capacity (OPTIONAL) ────────────────────────────────────────────
# Mongo connection pool per Node process (default 50, min 10, max 200).
MONGODB_MAX_POOL_SIZE=
# How long to wait for a free pool slot before failing (default 10000 ms).
MONGODB_WAIT_QUEUE_TIMEOUT_MS=
# Max concurrent authenticated runtime requests per Node process (default 32).
RUNTIME_MAX_IN_FLIGHT=

# ─── Core (REQUIRED — the app will not work without these) ──────────────────
# MongoDB connection string (Atlas replica set; transactions require it).
MONGODB_URI=
# Secret used to sign/verify app-level tokens. Generate: openssl rand -hex 32
AUTH_SECRET=
# Origin used in OAuth callbacks and request-scoped behavior (no trailing slash).
# Production: https://atai.ink — the retired workspace subdomains must not appear here.
NEXT_PUBLIC_APP_URL=
# Canonical PUBLIC origin for SEO output: rel=canonical, og:url, JSON-LD,
# sitemap.xml, robots.txt, and links sent in emails / payment returns.
# Empty is correct — the app already pins this to https://atai.ink. Set it only
# to publish a different official origin (e.g. a staging domain).
NEXT_PUBLIC_SITE_URL=
# Auth IP limits use Vercel's verified header only when VERCEL=1 (platform managed).
# Self-hosted: set the exact number of trusted proxy hops (1-10), and firewall
# the origin so clients cannot reach it directly or through shorter proxy paths.
# Each proxy must append the observed peer to X-Forwarded-For. Never trust client headers directly.
# Production auth returns 503 when no verified identity is available; development uses a shared bucket.
TRUSTED_PROXY_HOPS=
# SMTP for verification / password-reset mail.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ─── Media uploads (REQUIRED for project assets + visual mockups) ───────────
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ─── OAuth sign-in (OPTIONAL — omit to disable Google/GitHub login) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_BASE_URL=

# ─── Scheduled jobs (REQUIRED for Vercel Cron) ──────────────────────────────
# Vercel Cron calls the sweep endpoints with `Authorization: Bearer <this>`.
# Without it those routes only accept an admin session. Generate: openssl rand -hex 32
CRON_SECRET=

# ─── Business claim tokens (OPTIONAL) ───────────────────────────────────────
# Verification tokens are encrypted at rest. Leave empty to derive the key from
# AUTH_SECRET; set 32 bytes (64 hex chars or base64) only to rotate independently.
DOMAIN_TOKEN_KEY=
